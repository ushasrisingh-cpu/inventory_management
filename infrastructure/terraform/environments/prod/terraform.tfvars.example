aws_region                        = "us-east-1"
project_name                      = "inventory-management"
environment                       = "prod"
vpc_cidr                          = "10.30.0.0/16"
availability_zones                = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs               = ["10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs              = ["10.30.11.0/24", "10.30.12.0/24"]
nat_gateway_strategy              = "per_az"
enable_flow_logs                  = true
log_retention_days                = 90
flow_logs_kms_key_arn             = null
tags                              = {}
ecr_repository_name               = "inventory-management"
ecr_image_retention_count         = 30
ecr_kms_key_arn                   = null
eks_cluster_name                  = "inventory-management-prod"
eks_kubernetes_version            = "1.29"
eks_node_instance_types           = ["t3.medium"]
eks_node_desired_size             = 2
eks_node_min_size                 = 2
eks_node_max_size                 = 6
eks_enable_public_endpoint        = false
eks_public_endpoint_cidrs         = []
eks_cluster_log_types             = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
eks_secrets_kms_key_arn            = null
eks_require_imdsv2                = true
enable_github_oidc                = true
github_repository                 = "owner/repository"
github_branch                     = "master"
rds_instance_class                = "db.t3.small"
rds_database_name                 = "inventory"
rds_username                      = "inventory_admin"
rds_engine_version                = null
rds_multi_az                      = true
rds_deletion_protection           = true
rds_skip_final_snapshot           = false
rds_enable_performance_insights   = true
rds_enable_enhanced_monitoring    = true
rds_monitoring_interval           = 60
rds_cloudwatch_log_exports        = ["audit", "error", "general", "slowquery"]
rds_kms_key_arn                   = null

# Supply the production password through a secret-aware mechanism, never in Git.
# rds_password = "replace-me"
module "infrastructure" {
  source = "../.."

  aws_region                      = var.aws_region
  project_name                    = var.project_name
  environment                     = var.environment
  vpc_cidr                        = var.vpc_cidr
  availability_zones              = var.availability_zones
  public_subnet_cidrs             = var.public_subnet_cidrs
  private_subnet_cidrs            = var.private_subnet_cidrs
  nat_gateway_strategy            = var.nat_gateway_strategy
  enable_flow_logs                = var.enable_flow_logs
  log_retention_days              = var.log_retention_days
  flow_logs_kms_key_arn           = var.flow_logs_kms_key_arn
  tags                            = var.tags
  ecr_repository_name             = var.ecr_repository_name
  ecr_image_retention_count       = var.ecr_image_retention_count
  ecr_kms_key_arn                 = var.ecr_kms_key_arn
  eks_cluster_name                = var.eks_cluster_name
  eks_kubernetes_version          = var.eks_kubernetes_version
  eks_node_instance_types         = var.eks_node_instance_types
  eks_node_desired_size           = var.eks_node_desired_size
  eks_node_min_size               = var.eks_node_min_size
  eks_node_max_size               = var.eks_node_max_size
  enable_public_eks_endpoint      = var.eks_enable_public_endpoint
  public_endpoint_cidrs           = var.eks_public_endpoint_cidrs
  eks_cluster_log_types           = var.eks_cluster_log_types
  eks_secrets_kms_key_arn         = var.eks_secrets_kms_key_arn
  require_imdsv2                  = var.eks_require_imdsv2
  enable_github_oidc              = var.enable_github_oidc
  github_repository               = var.github_repository
  github_branch                   = var.github_branch
  rds_instance_class              = var.rds_instance_class
  rds_database_name               = var.rds_database_name
  rds_username                    = var.rds_username
  rds_password                    = var.rds_password
  rds_engine_version              = var.rds_engine_version
  rds_multi_az                    = var.rds_multi_az
  rds_deletion_protection         = var.rds_deletion_protection
  rds_skip_final_snapshot         = var.rds_skip_final_snapshot
  rds_enable_performance_insights = var.rds_enable_performance_insights
  rds_enable_enhanced_monitoring  = var.rds_enable_enhanced_monitoring
  rds_monitoring_interval         = var.rds_monitoring_interval
  rds_cloudwatch_log_exports      = var.rds_cloudwatch_log_exports
  rds_kms_key_arn                 = var.rds_kms_key_arn
}

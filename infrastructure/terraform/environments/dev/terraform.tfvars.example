aws_region                     = "ap-south-1"
project_name                   = "inventory-management"
environment                    = "dev"
vpc_cidr                       = "10.20.0.0/16"
availability_zones             = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs            = ["10.20.1.0/24", "10.20.2.0/24"]
private_subnet_cidrs           = ["10.20.11.0/24", "10.20.12.0/24"]
enable_nat_gateway             = false
nat_gateway_strategy            = "single"
enable_flow_logs                = true
log_retention_days = 365
flow_logs_kms_key_arn           = null
tags                            = {}
ecr_repository_name             = "inventory-management"
ecr_image_retention_count      = 10
ecr_kms_key_arn                 = null
ecs_container_name              = "inventory-management"
ecs_image_tag                  = "IMMUTABLE_IMAGE_TAG"
ecs_cpu                        = 256
ecs_memory                     = 512
ecs_desired_count              = 0
ecs_app_port                   = 8080
ecs_assign_public_ip           = true
ecs_log_retention_days         = 30
ecs_health_check_path          = "/actuator/health/readiness"
spring_profiles_active         = "prod"
enable_github_oidc             = true
github_repository              = "owner/repository"
github_branch                  = "master"
rds_instance_class             = "db.t3.micro"
rds_database_name              = "inventory"
rds_username                   = "inventory_admin"
rds_engine_version             = null
rds_multi_az                   = false
rds_deletion_protection        = false
rds_skip_final_snapshot        = true
rds_enable_performance_insights = false
rds_enable_enhanced_monitoring  = false
rds_monitoring_interval        = 0
rds_cloudwatch_log_exports     = []
rds_kms_key_arn                = null

# Push an image, then set ecs_desired_count = 1 before plan/apply.